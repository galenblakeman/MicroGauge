<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <PackageId>MicroGauge.Blazor</PackageId>
        <Version>1.1.0.1</Version>
        <Authors>Galen Blakeman</Authors>
        <Company></Company>
        <PackageDescription>MicroGauge.Blazor is a MicroGauge view library with tags and bindings for customization</PackageDescription>
        <PackageProjectUrl>https://github.com/galenblakeman/MicroGauge</PackageProjectUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageTags>skia;skiasharp;c-sharp;dotnet;gauge;blazor</PackageTags>
        <Copyright>Galen Blakeman</Copyright>
        <!-- BL0007: parameter setters intentionally forward to the wrapped Gauge and repaint -->
        <NoWarn>$(NoWarn);BL0007</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <!-- Browser-only library: SKGLView requires the browser platform -->
        <SupportedPlatform Remove="@(SupportedPlatform)" />
        <SupportedPlatform Include="browser" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="SkiaSharp.Views.Blazor" Version="4.150.1" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\MicroGauge\MicroGauge.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

</Project>
