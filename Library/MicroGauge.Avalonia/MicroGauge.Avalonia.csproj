<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>MicroGauge.Avalonia</PackageId>
    <Version>1.1.0.2</Version>
    <Authors>Galen Blakeman</Authors>
    <PackageDescription>MicroGauge controls for Avalonia</PackageDescription>
    <PackageProjectUrl>https://github.com/galenblakeman/MicroGauge</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>skia;skiasharp;c-sharp;dotnet;gauge;avalonia</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.4" />
    <PackageReference Include="SkiaSharp" Version="4.150.1" />
    <ProjectReference Include="..\MicroGauge\MicroGauge.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
